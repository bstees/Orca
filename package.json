{
  "name": "orca",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "resolutions": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-systemjs": "^7.29.7",
    "@xmldom/xmldom": "^0.8.15",
    "baseline-browser-mapping": "^2.11.0",
    "brace-expansion": "^5.0.6",
    "body-parser": "^2.4.0",
    "browserslist": "^4.28.7",
    "compression": "^1.8.2",
    "fast-uri": "^3.1.9",
    "hono": "^4.13.11",
    "ip-address": "^10.7.4",
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^6.1.5",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "shell-quote": "^1.9.0",
    "source-map-js": "^1.2.2",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "type": "module",
  "scripts": {
    "dev": "yarn workspace @orca/server dev",
    "dev:app": "yarn workspace @orca/app dev",
    "dev:desktop": "ORCA_DEV=1 yarn workspace @orca/desktop dev",
    "dev:mobile": "yarn workspace @orca/mobile start",
    "build": "yarn workspaces foreach --all run build",
    "test": "jest",
    "mutate": "yarn workspaces foreach --all --exclude @orca/extension run mutate",
    "lint": "eslint 'packages/*/src/**/*.{js,jsx}'",
    "lint-fix": "eslint --fix 'packages/*/src/**/*.{js,jsx}'"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-jsx": "^7.24.7",
    "@babel/plugin-transform-modules-commonjs": "^7.24.8",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.24.7",
    "@eslint/js": "^9.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/jest-runner": "^9.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^30.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jest-css-modules-transform": "^4.4.2",
    "jest-environment-jsdom": "^30.0.0",
    "prettier": "^3.0.0",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^37.0.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
