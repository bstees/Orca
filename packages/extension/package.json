{
  "name": "orca-session-manager",
  "displayName": "Orca Session Manager",
  "description": "Connects VS Code to the Orca session dashboard and routes mobile prompts to Copilot Chat.",
  "publisher": "orca-local",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/extension.js",
  "scripts": {
    "test": "jest",
    "build": "node esbuild.js",
    "vscode:prepublish": "node esbuild.js"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Orca",
      "properties": {
        "orca.serverUrl": {
          "type": "string",
          "default": "ws://localhost:7337",
          "description": "Orca server WebSocket URL"
        },
        "orca.idleSeconds": {
          "type": "number",
          "default": 30,
          "description": "Seconds of inactivity before session is marked idle"
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "ws": "^8.20.0"
  }
}
