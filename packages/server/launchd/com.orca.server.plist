  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/bstees/.orca/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bstees/.orca/server-error.log</string>
</dict>
</plist>
